<%- include('partials/head', { title }) %>
<section class="section">
<div class="container">
<article class="article">
<h1><%= item.judul %></h1>
<div class="news-meta"><%= new Date(item.publishedAt).toLocaleDateString('id-ID') %> • <%= item.kategori || 'Umum' %></div>
<% if (item.thumbnailUrl) { %>
<img class="article-thumb" src="<%= item.thumbnailUrl %>" alt="<%= item.judul %>"/>
<% } %>
<div class="content"><%- item.konten %></div>
</article>
</div>
</section>
<%- include('partials/footer') %>