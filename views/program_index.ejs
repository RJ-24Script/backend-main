<%- include('partials/head', { title }) %>
<section class="section">
<div class="container">
<h2>Program & Layanan</h2>
<ul class="cards">
<% list.forEach(p => { %>
<li class="card">
<h3><a href="/program/<%= p.slug %>"><%= p.nama %></a></h3>
<p><%= (p.deskripsi || '').slice(0, 140) %>...</p>
</li>
<% }) %>
</ul>
</div>
</section>
<%- include('partials/footer') %>